APP_NAME=PigeonAgent
API_V1_PREFIX=/api/v1
# 本地直接跑后端时默认连本机 PostgreSQL；docker compose 里要改成服务名 postgres。
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pigeon
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# docker compose 暴露的前端端口
# FRONTEND_PORT=8080

# 站点展示信息（公开接口 /api/v1/configs/public 下发）。
# 首次启动会把这些值写进 app_configs 表；之后以数据库值为准。
# SITE_NAME=PigeonAgent
# SITE_DESCRIPTION=大模型驱动的智能体工作台
# SITE_LOGO_URL=

# 必填：缺失或仍为旧示例值时应用会拒绝启动。生成一把：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# 本地临时用 SQLite（需要 dev extra 里的 aiosqlite）
# DATABASE_URL=sqlite+aiosqlite:///./pigeon.db
# pytest 始终使用内存 SQLite，不受这里影响

# SSE 事件队列：内存里最多保留多少条事件，超出部分落到临时 jsonl；
# 运行结束且消费者全部退出后临时文件自动删除。0=不限。
# RENDER_QUEUE_MAX_BACKLOG=10000

# Redis：配置后 SSE 事件流与「每会话一个活跃 run」的互斥放进 Redis，
# 多个 uvicorn worker 共享同一份状态（事件队列改由 Redis Streams 承载）。
# 留空=进程内实现，只支持单 worker。
# REDIS_URL=redis://127.0.0.1:6379/0
# run 结束后事件流在 Redis 里的保留秒数，迟到的标签页仍能回放
# RENDER_RETAIN_SECONDS=600

# 对象存储（S3 协议：AWS S3 / 阿里云 OSS / MinIO / RustFS）。不配 S3_BUCKET 就是未启用。
# S3_ENDPOINT_URL=http://127.0.0.1:9000        # 留空=AWS；OSS 填 https://oss-cn-hangzhou.aliyuncs.com
# S3_PUBLIC_ENDPOINT_URL=https://s3.example.com # 浏览器直连地址；留空沿用 S3_ENDPOINT_URL。
#                                               # HTTPS 站点必须配 HTTPS 地址，否则图片会被混合内容拦截。
# S3_PUBLIC_PORT=9000                           # docker compose 暴露给宿主机的 RustFS 端口
# S3_REGION=us-east-1                           # OSS 要填它自己的 region，如 cn-hangzhou
# S3_BUCKET=pigeon
# S3_ACCESS_KEY=your-key
# S3_SECRET_KEY=your-secret
# S3_PREFIX=pigeon                              # 对象 key 的根前缀
# S3_ADDRESSING_STYLE=path                      # MinIO / RustFS 用 path，OSS 用 virtual
# S3_PRESIGN_TTL_SECONDS=600                    # 上传签名 URL 有效期
# FILE_LINK_TTL_SECONDS=21600                   # 图片/视频直链（预签名 GET）有效期
# MAX_UPLOAD_BYTES=20971520
# BLOB_GRACE_SECONDS=86400                      # blob 引用归零后的宽限期
# GC_INTERVAL_SECONDS=3600                      # 巡检间隔；0=只留启动时一次
# UPLOAD_SESSION_TTL_SECONDS=7200               # presign 上传会话有效期

# e2b 兼容沙箱（阿里云 Agent Sandbox）。不配 SANDBOX_API_KEY 就走本地临时目录工具。
# 也可以在数据库 app_configs 里配置，修改后下一轮 run 生效。
# region 按控制台所在地域填，例如杭州：
# SANDBOX_API_KEY=e2b_xxx
# SANDBOX_API_URL=https://api.cn-hangzhou.e2b.fc.aliyuncs.com
# SANDBOX_DOMAIN=cn-hangzhou.e2b.fc.aliyuncs.com
# SANDBOX_TEMPLATE=code-interpreter-v1
# SANDBOX_IDLE_SECONDS=600                      # 无动静多久回收
# WORKSPACE_ROOT=                               # 本地工作区根目录；空=系统临时目录

# 联网搜索 / 网页抓取（DeepSeek Search & Fetch）
# 文档：https://api-docs.deepseek.com/zh-cn/api/search
# 也可以在数据库 app_configs 里配置；环境变量没配时前端搜索开关不可用
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_API_BASE=https://api.deepseek.com
# DEEPSEEK_SEARCH_TIMEOUT_SECONDS=20
# DEEPSEEK_FETCH_TIMEOUT_SECONDS=30

# 默认管理员：首次启动且库中还没有任何用户时自动创建。
# 公开部署前务必改成强密码；保持 change-me / admin123456 会在启动时告警。
ADMIN_EMAIL=admin@pigeon.local
ADMIN_PASSWORD=change-me

# JWT
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# SMTP（邮箱验证码发件用）。不配 SMTP_HOST 就不发邮件。
# 也可以在数据库 app_configs 里配置。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_TLS=starttls                       # none / starttls / ssl
# EMAIL_FROM=PigeonAgent <no-reply@example.com>
# EMAIL_VERIFICATION_REQUIRED=true        # 配了 SMTP 且要验证码登录才设 true

# 操作日志：所有 HTTP 操作异步写入 operation_logs；也可在后台「日志配置」修改
# OPERATION_LOG_ENABLED=true
# OPERATION_LOG_QUEUE_MAX=10000
# OPERATION_LOG_BATCH_SIZE=200
# OPERATION_LOG_FLUSH_MS=500
# OPERATION_LOG_MAX_REQUEST_BODY=8192
# OPERATION_LOG_MAX_RESPONSE_BODY=16384
# OPERATION_LOG_RETENTION_DAYS=30
# OPERATION_LOG_EXCLUDE_PATHS=/api/v1/health,/api/v1/ready,/api/v1/files/*/link,/docs,/openapi.json,/redoc
# OPERATION_LOG_TRUST_PROXY=false

# 应用配置项
# 优先级：数据库 > 环境变量 > 代码默认。首次启动只补齐 app_configs 配置行，
# 不会把这里的值复制进数据库；PATCH 成 null 可撤销数据库覆盖，回落到环境变量 / 代码默认。
